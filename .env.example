APP_NAME=TaskFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=stack
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=taskflow
DB_USERNAME=taskflow
DB_PASSWORD=local-taskflow-db

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
TRUSTED_PROXIES=
SECURITY_HSTS=false
CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=taskflow
RABBITMQ_PASSWORD=local-taskflow-broker
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=taskflow
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672

# Explicit local-only Compose credentials. Change before any non-local deployment.
TASKFLOW_DB_PASSWORD=local-taskflow-db
TASKFLOW_RABBITMQ_PASSWORD=local-taskflow-broker
MAIL_MAILER=log
