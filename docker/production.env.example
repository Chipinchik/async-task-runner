# Reference for a separate PHP-FPM deployment, NOT an override for local compose.yaml.
# Copy outside the repository, fill every empty secret and restrict file permissions.
APP_NAME=TaskFlow
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://taskflow.example.com
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
DB_CONNECTION=pgsql
DB_HOST=postgres.internal
DB_PORT=5432
DB_DATABASE=taskflow
DB_USERNAME=taskflow
DB_PASSWORD=
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=taskflow
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/taskflow
RABBITMQ_QUEUE=taskflow
RABBITMQ_MANAGEMENT_URL=http://rabbitmq.internal:15672
FILESYSTEM_DISK=local
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true
CACHE_STORE=database
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SECURITY_HSTS=true
# Exact reverse proxy addresses or private CIDRs. Never blindly trust '*'.
TRUSTED_PROXIES=
